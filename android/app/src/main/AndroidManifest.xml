<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Flutter's template declares INTERNET only in the debug and profile
      manifests, so a release build has no network access at all: the server
      client and device discovery both fail while the same code works from the
      IDE. It has to be declared here to reach release builds.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Reading the current network state before reaching for the server. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      Playing on with the app in the background. Android stops a process with
      nothing visible, so the decoder only survives inside a foreground
      service; the typed permission is required from Android 14.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!--
      The media notification, from Android 13. A denial hides the
      notification but does not stop the service, so playback continues
      either way — it just loses its controls.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      **No media-read permissions.** READ_MEDIA_VIDEO, READ_EXTERNAL_STORAGE
      and READ_MEDIA_VISUAL_USER_SELECTED were here for the Files tab, which
      was built from MediaStore because scoped storage forbids listing shared
      storage directly. There is no device library any more: mPlayer plays
      what a media server gives it, so asking for access to the user's own
      videos would be asking for something it has no use for.
    -->

    <!--
      A touchscreen is not required: mPlayer is driveable with a remote or a
      mouse. Declaring it optional is also what keeps the app installable on
      Android TV and on Chromebooks without a touch panel.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="video"
        android:networkSecurityConfig="@xml/network_security_config">
        <!--
          singleTask rather than Flutter's default singleTop. It was for the
          VIEW intents: with singleTop, one arriving while mPlayer was in the
          background built a second MainActivity on top of the first and the
          user ended up with a stack of players. No intent is routed here now,
          but a second launch still has no business becoming a second activity.
        -->
        <!--
          supportsPictureInPicture needs resizeableActivity beside it: a
          non-resizeable activity is never offered PiP, and the system also
          resizes the window on the way in and out.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!--
              go_router owns in-app navigation, and Flutter's own deep-link
              handling would try to route anything arriving as a location.
              Nothing is sent here now, but leaving it enabled would mean the
              next intent filter added quietly stops working.
            -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
              **Every VIEW and SEND filter is gone.** mPlayer used to claim
              video/*, a long list of containers Android has no MIME type for,
              the streaming schemes, and the share sheet, so that "open with
              mPlayer" and "send to mPlayer" reached its player. The player is
              still here, but it only opens what a media server resolved —
              there is no local source left to turn a handed-over file into
              something playable. An app that appeared in the chooser and then
              had nowhere to put the file would be worse than one that does
              not appear.
            -->
        </activity>
        <!--
          The Cast SDK finds its configuration by class name, so this entry is
          the only reference to CastOptionsProvider — renaming the class
          without editing this breaks casting at runtime, not at compile time.
        -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="dev.icedtea.mplayer.CastOptionsProvider"/>

        <!--
          Not exported: every start comes from this app's own channel, and the
          service takes no action a foreign app has any business triggering.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!--
          Opening the repository and the release notes in a browser. From
          Android 11 an app cannot even see whether a browser exists without
          declaring the intent here, and `launchUrl` then fails with nothing
          to show for it.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
